# Pickly — بوابة HTTPS تلقائية: الدومين الرسمي thepickly.com + عناوين sslip.io كاحتياط
# (كلها تحلّ إلى 193.122.83.224). HTTPS إلزامي كي يسمح المتصفح بتحديد الموقع على الأجهزة.
# Caddy يجلب شهادة Let's Encrypt لكل مضيف تلقائياً (تحدي HTTP-01 على المنفذ 80)،
# ويظل يعيد المحاولة تلقائياً إن لم يكن DNS الدومين موجهاً بعد.

# ————— الدومين الرسمي —————

# اللاندنق (الموقع التعريفي) — النطاق الرئيسي
thepickly.com {
	reverse_proxy site:3004
}

www.thepickly.com {
	redir https://thepickly.com{uri} permanent
}

# تطبيق العميل
app.thepickly.com {
	reverse_proxy customer-web:3000
}

# بوابة التاجر
merchant.thepickly.com {
	reverse_proxy merchant-web:3001
}

# تشغيل الفرع
branch.thepickly.com {
	reverse_proxy branch-ops:3002
}

# لوحة السوبر أدمن
admin.thepickly.com {
	reverse_proxy admin-web:3003
}

# الـAPI عبر HTTPS — تحتاجه بوابة الدفع لإرسال webhooks موقّعة إلى
# https://api.thepickly.com/v1/webhooks/payments/moyasar (البوابات لا تقبل HTTP)
api.thepickly.com {
	reverse_proxy api:4000
}

# site. القديم يحوّل للنطاق الرئيسي (اللاندنق صارت عليه)
site.thepickly.com {
	redir https://thepickly.com{uri} permanent
}

# ————— عناوين sslip.io الاحتياطية —————

# واجهة العميل — النطاق الرئيسي
193-122-83-224.sslip.io {
	reverse_proxy customer-web:3000
}

# بوابة التاجر
merchant.193-122-83-224.sslip.io {
	reverse_proxy merchant-web:3001
}

# تشغيل الفرع
branch.193-122-83-224.sslip.io {
	reverse_proxy branch-ops:3002
}

# لوحة السوبر أدمن
admin.193-122-83-224.sslip.io {
	reverse_proxy admin-web:3003
}

# الموقع التعريفي
site.193-122-83-224.sslip.io {
	reverse_proxy site:3004
}

# ── مستأجرون خارجيون: كل مشروع يملك شظيته ولا يحرّر هذا الملف ──────────
# الشظايا في /data/conf.d/*.caddyfile (فوليوم vm_caddydata، مركّب أصلاً على /data).
# اليوم: medifysa.caddyfile (مشروع Medify ← 172.18.0.1:8080/8081).
# هذا السطر ثابت — إضافة دومين لاحقاً = ملف جديد هناك، بلا أي تعديل هنا.
import /data/conf.d/*.caddyfile
